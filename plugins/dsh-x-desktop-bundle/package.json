{
  "name": "dsh-x-desktop-bundle",
  "version": "0.1.0",
  "description": "DSH-X 桌面插件组：一个包挂全组，profile 只加一个依赖。首版成员是 dsh-x-desktop-notify（宿主侧原生通知 + dshDesktop 服务）；以后加成员 = 加依赖 + 加一行 patch，用户侧仍只装这一个包。",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop",
    "dsh-x"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0"
    }
  },
  "dependencies": {
    "dsh-x-desktop-notify": "^0.1.0"
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "DSH-X Desktop",
    "summary": "DSH-X 的桌面插件组：一个依赖挂全组。首版提供宿主侧原生通知（一轮结束、等待确认）与 dshDesktop 桌面能力服务（notify / open / reveal / clipboard / dialog）。",
    "categories": [
      "桌面",
      "通知"
    ],
    "homepage": "https://github.com/yyh-001/DSH-X"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyh-001/DSH-X.git"
  },
  "author": "yyh",
  "license": "MIT"
}
